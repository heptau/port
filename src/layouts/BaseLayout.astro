---
import '../styles/global.css';
import Search from '../components/Search.astro';

export interface Props {
	title: string;
	description?: string;
	locale?: string;
	canonical?: string;
	enPath?: string;
	csPath?: string;
	esPath?: string;
	dePath?: string;
	ptPath?: string;
}

const { title, description, locale = 'en', canonical, enPath, csPath, esPath, dePath, ptPath } = Astro.props;

const allLocales = ['en', 'cs', 'es', 'de', 'pt'] as const;
const langPaths: Record<string, string | undefined> = { en: enPath, cs: csPath, es: esPath, de: dePath, pt: ptPath };

const FLAGS: Record<string, string> = { en: '🇬🇧', cs: '🇨🇿', es: '🇪🇸', de: '🇩🇪', pt: '🇵🇹' };
const LANG_LABELS: Record<string, string> = { en: 'English', cs: 'Čeština', es: 'Español', de: 'Deutsch', pt: 'Português' };
const THEME_LABELS: Record<string, string> = { auto: '🖥️ Auto', light: '☀️ Light', dark: '🌙 Dark' };
const NAV_TOOLTIPS: Record<string, { home: string; categories: string; theme: string; language: string }> = {
	en: { home: 'Home',    categories: 'Categories', theme: 'Theme',        language: 'Language' },
	cs: { home: 'Domů',   categories: 'Kategorie',  theme: 'Vzhled',       language: 'Jazyk'    },
	es: { home: 'Inicio', categories: 'Categorías', theme: 'Apariencia',   language: 'Idioma'   },
	de: { home: 'Start',  categories: 'Kategorien', theme: 'Erscheinungsbild', language: 'Sprache' },
	pt: { home: 'Início', categories: 'Categorias', theme: 'Aparência',    language: 'Idioma'   },
};
const tt = NAV_TOOLTIPS[locale] ?? NAV_TOOLTIPS.en;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description ?? title} />
		<meta name="author" content="Zbyněk Vanžura" />
		<link rel="alternate" type="application/rss+xml" title="port.80.cz" href={locale === 'en' ? '/rss.xml' : `/${locale}/rss.xml`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description ?? title} />
		<meta property="og:image" content="https://port.80.cz/favicon.png" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		{canonical && <link rel="canonical" href={canonical} />}
		<title>{title}</title>
		<script is:inline>
			(function() {
				var t = localStorage.getItem('port_theme');
				if (t === 'light') { document.documentElement.setAttribute('data-theme', 'light'); }
				else if (t === 'dark') { document.documentElement.setAttribute('data-theme', 'dark'); }
				else if (window.matchMedia('(prefers-color-scheme: light)').matches) { document.documentElement.setAttribute('data-theme', 'light'); }
			})();
		</script>
		<script is:inline define:vars={{ langPathsData: langPaths, currentLocale: locale }}>
			(function() {
				var SUPPORTED = ['en', 'cs', 'es', 'de', 'pt'];
				var saved = localStorage.getItem('port_lang');
				var target;
				if (!saved || saved === 'auto') {
					var langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || 'en'];
					target = 'en';
					for (var i = 0; i < langs.length; i++) {
						var code = langs[i].split('-')[0].toLowerCase();
						if (SUPPORTED.indexOf(code) !== -1) { target = code; break; }
					}
				} else {
					target = SUPPORTED.indexOf(saved) !== -1 ? saved : 'en';
				}
				if (target !== currentLocale) {
					var path = langPathsData[target] || (target === 'en' ? '/' : '/' + target);
					window.location.replace(path);
				}
			})();
		</script>
	</head>
	<body>
		<header>
			<nav aria-label="Main">
				<a class="nav-icon home-icon" href={locale === 'en' ? '/' : `/${locale}`} aria-label={tt.home} title={tt.home}>
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
						<polyline points="9 22 9 12 15 12 15 22"/>
					</svg>
				</a>
				<div class="cat-dropdown">
					<button class="cat-trigger" aria-label={tt.categories} title={tt.categories} aria-haspopup="true" aria-expanded="false">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="3" width="7" height="7"/>
							<rect x="14" y="3" width="7" height="7"/>
							<rect x="3" y="14" width="7" height="7"/>
							<rect x="14" y="14" width="7" height="7"/>
						</svg>
					</button>
					<div class="dropdown-menu cat-menu">
						<a class="dropdown-option" href={locale === 'en' ? '/PostgreSQL' : `/${locale}/PostgreSQL`}>PostgreSQL</a>
						<a class="dropdown-option" href={locale === 'en' ? '/AI' : `/${locale}/AI`}>AI</a>
					</div>
				</div>
				<div class="nav-spacer"></div>
				<Search locale={locale} />
				<div class="nav-spacer"></div>
				<div class="theme-dropdown">
					<button class="theme-trigger" aria-label={tt.theme} title={tt.theme} aria-haspopup="true" aria-expanded="false">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
							<path d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18V4c4.42 0 8 3.58 8 8s-3.58 8-8 8z"/>
						</svg>
					</button>
					<div class="dropdown-menu theme-menu">
						<button class="dropdown-option theme-option" data-theme="auto">{THEME_LABELS.auto}</button>
						<button class="dropdown-option theme-option" data-theme="light">{THEME_LABELS.light}</button>
						<button class="dropdown-option theme-option" data-theme="dark">{THEME_LABELS.dark}</button>
					</div>
				</div>
				<div class="lang-dropdown">
					<button class="lang-trigger" aria-label={tt.language} title={tt.language} aria-haspopup="true" aria-expanded="false">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<line x1="2" y1="12" x2="22" y2="12"/>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
						</svg>
					</button>
					<div class="dropdown-menu lang-menu">
						<button class="dropdown-option lang-option" data-locale="auto">🌐 Auto</button>
						{allLocales.map(l => (
							<a class="dropdown-option lang-option" data-locale={l} href={langPaths[l] ?? (l === 'en' ? '/' : `/${l}`)}>
								{FLAGS[l]} {LANG_LABELS[l]}
							</a>
						))}
					</div>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<script>
			(function() {
				var els = document.querySelectorAll('[data-publish-date]');
				var now = new Date();
				for (var i = 0; i < els.length; i++) {
					if (new Date(els[i].getAttribute('data-publish-date')) > now) {
						els[i].style.display = 'none';
					}
				}
			})();

			const themeDropdown = document.querySelector('.theme-dropdown');
			const themeTrigger = document.querySelector('.theme-trigger');
			const themeOptions = document.querySelectorAll('.theme-option');
			const langDropdown = document.querySelector('.lang-dropdown');
			const langTrigger = document.querySelector('.lang-trigger');
			const langOptions = document.querySelectorAll('.lang-option');
			const catDropdown = document.querySelector('.cat-dropdown');
			const catTrigger = document.querySelector('.cat-trigger');

			const ALL_DROPDOWNS = '.lang-dropdown, .theme-dropdown, .cat-dropdown';

			function applyTheme(theme) {
				if (theme === 'auto') {
					document.documentElement.removeAttribute('data-theme');
				} else {
					document.documentElement.setAttribute('data-theme', theme);
				}
				localStorage.setItem('port_theme', theme);
				themeOptions.forEach(function(opt) {
					opt.classList.toggle('active', opt.getAttribute('data-theme') === theme);
				});
				if (themeDropdown) themeDropdown.classList.remove('open');
			}

			function updateLangActive() {
				var saved = localStorage.getItem('port_lang') || 'auto';
				langOptions.forEach(function(opt) {
					opt.classList.toggle('active', opt.getAttribute('data-locale') === saved);
				});
			}

			function setupDropdown(trigger, dropdown) {
				if (!trigger || !dropdown) return;
				trigger.addEventListener('click', function(e) {
					e.stopPropagation();
					var wasOpen = dropdown.classList.contains('open');
					document.querySelectorAll(ALL_DROPDOWNS).forEach(function(d) { d.classList.remove('open'); });
					if (!wasOpen) dropdown.classList.add('open');
					trigger.setAttribute('aria-expanded', !wasOpen);
				});
			}

			var stored = localStorage.getItem('port_theme') || 'auto';
			applyTheme(stored);
			updateLangActive();

			setupDropdown(themeTrigger, themeDropdown);
			setupDropdown(langTrigger, langDropdown);
			setupDropdown(catTrigger, catDropdown);

			themeOptions.forEach(function(opt) {
				opt.addEventListener('click', function() {
					applyTheme(opt.getAttribute('data-theme'));
				});
			});

			langOptions.forEach(function(opt) {
				opt.addEventListener('click', function() {
					var loc = opt.getAttribute('data-locale');
					localStorage.setItem('port_lang', loc);
					if (loc === 'auto') {
						var SUPPORTED = ['en', 'cs', 'es', 'de', 'pt'];
						var langs = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || 'en'];
						var target = 'en';
						for (var i = 0; i < langs.length; i++) {
							var code = langs[i].split('-')[0].toLowerCase();
							if (SUPPORTED.indexOf(code) !== -1) { target = code; break; }
						}
						var el = document.querySelector('.lang-option[data-locale="' + target + '"]');
						var href = el ? el.getAttribute('href') : (target === 'en' ? '/' : '/' + target);
						window.location.href = href || '/';
					}
					updateLangActive();
				});
			});

			document.addEventListener('click', function() {
				document.querySelectorAll(ALL_DROPDOWNS).forEach(function(d) { d.classList.remove('open'); });
			});
		</script>
	</body>
</html>
