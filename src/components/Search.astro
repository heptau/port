---
const SEARCH_LABELS: Record<string, string> = {
	en: 'Search…',
	cs: 'Hledat…',
	es: 'Buscar…',
	de: 'Suchen…',
	pt: 'Pesquisar…',
};
const locale = Astro.props.locale as string || 'en';
const placeholder = SEARCH_LABELS[locale] ?? SEARCH_LABELS.en;
---

<div class="search-wrapper">
	<form class="search-form" role="search">
		<svg class="search-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="8"/>
			<line x1="21" y1="21" x2="16.65" y2="16.65"/>
		</svg>
		<input type="search" class="search-input" placeholder={placeholder} aria-label={placeholder} />
	</form>
	<div class="search-results"></div>
</div>

<script is:inline type="module">
	const form = document.querySelector('.search-form');
	const input = form?.querySelector('input');
	const results = document.querySelector('.search-results');

	let pagefind = null;

	async function loadPagefind() {
		if (!pagefind) {
			try {
				const mod = await import('/pagefind/pagefind.js');
				pagefind = mod;
				console.log('Pagefind loaded');
			} catch (err) {
				console.error('Pagefind load failed:', err);
			}
		}
	}

	input?.addEventListener('focus', loadPagefind);

	form?.addEventListener('submit', (e) => e.preventDefault());

	input?.addEventListener('input', async () => {
		const q = input.value.trim();
		if (q.length < 2) {
			results.innerHTML = '';
			results.classList.remove('open');
			return;
		}
		await loadPagefind();
		if (!pagefind) return;

		try {
			const searchRes = await pagefind.search(q);
			if (!searchRes.results || searchRes.results.length === 0) {
				results.innerHTML = '<div class="sr-empty">No results</div>';
				results.classList.add('open');
				return;
			}

			const items = await Promise.all(searchRes.results.slice(0, 8).map(r => r.data()));

			results.innerHTML = items.map(item => {
				const url = item.url.replace(/\/$/, '');
				return `<a class="sr-item" href="${url}">
					<span class="sr-title">${item.meta?.title || item.meta?.url || url}</span>
					<span class="sr-excerpt">${item.excerpt || ''}</span>
				</a>`;
			}).join('');
			results.classList.add('open');
		} catch (err) {
			console.error('Search error:', err);
		}
	});

	document.addEventListener('click', (e) => {
		const wrapper = document.querySelector('.search-wrapper');
		if (wrapper && !wrapper.contains(e.target)) {
			results.classList.remove('open');
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			results.classList.remove('open');
			input?.blur();
		}
		if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
			e.preventDefault();
			input?.focus();
		}
	});
</script>

<style>
	.search-wrapper {
		flex: 0 1 200px;
		min-width: 90px;
		position: relative;
	}

	.search-form {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 0.65rem;
		pointer-events: none;
		color: var(--text-dim);
		z-index: 1;
	}

	.search-input {
		-webkit-appearance: none;
		appearance: none;
		box-sizing: border-box;
		width: 100%;
		height: 2rem;
		padding: 0 0.65rem 0 2rem;
		font-family: var(--font-body);
		font-size: 0.8rem;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 100px;
		outline: none;
		transition: all 0.15s ease;
	}

	.search-input::placeholder {
		color: var(--text-dim);
	}

	.search-input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 25%, transparent);
		background: var(--bg-card);
	}

	.search-input::-webkit-search-decoration,
	.search-input::-webkit-search-cancel-button,
	.search-input::-webkit-search-results-button,
	.search-input::-webkit-search-results-decoration {
		-webkit-appearance: none;
	}

	.search-results {
		display: none;
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		right: 0;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		padding: 0.4rem;
		box-shadow: 0 12px 30px var(--shadow);
		z-index: 100;
	}

	.search-results.open {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.sr-item {
		display: block;
		padding: 0.5rem 0.75rem;
		border-radius: 0.4rem;
		text-decoration: none;
		transition: background 0.15s;
	}

	.sr-item:hover {
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}

	.sr-title {
		display: block;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text);
		line-height: 1.3;
	}

	.sr-excerpt {
		display: block;
		font-size: 0.75rem;
		color: var(--text-dim);
		margin-top: 0.15rem;
		line-height: 1.4;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sr-empty {
		padding: 0.75rem;
		font-size: 0.8rem;
		color: var(--text-dim);
		text-align: center;
	}

	@media (max-width: 480px) {
		.search-wrapper {
			order: 10;
			flex: 1 1 100%;
			margin: 0.5rem 0 0;
		}
	}
</style>
