---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/published';

const posts = await getCollection('blog', ({ data }) => data.locale === 'en' && isPublished(data));
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="port.80.cz" description="Zbyněk Vanžura's blog — practical insights from more than 20 years of experience, mostly about PostgreSQL, software development, and AI." locale="en">
	<h1>port.80.cz</h1>
	<p>Zbyněk Vanžura's blog — practical insights from more than 20 years of experience, mostly about PostgreSQL, software development, and AI, but occasionally also about other topics worth reflecting on.</p>
	<h2>Latest posts</h2>
	<PostList posts={posts.slice(0, 5)} />
	{posts.length > 5 && <p class="more-link"><a href="/archive">See all posts →</a></p>}
</BaseLayout>
