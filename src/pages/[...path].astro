---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../layouts/BlogPost.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrevNext from '../components/PrevNext.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/published';
import { CATEGORIES, categorySlug, categoryDisplay } from '../utils/categories';

const LOCALES = ['en', 'cs', 'es', 'de', 'pt'] as const;

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => data.locale === 'en' && isPublished(data));
	const pages: { params: { path?: string }; props: Record<string, unknown> }[] = [];

	for (const category of CATEGORIES) {
		pages.push({ params: { path: categorySlug(category) }, props: { pageType: 'category', category, locale: 'en' } });
	}

	for (const post of posts) {
		const slug = post.id.split('/').pop();
		pages.push({ params: { path: slug }, props: { pageType: 'post', slug: post.id, locale: 'en' } });
	}

	return pages;
}

const { path } = Astro.params;
const { pageType, slug, category } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => data.locale === 'en' && isPublished(data));
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function localePath(l: string, cat?: string): string {
	if (l === 'en') return cat ? `/${cat}` : '/';
	return cat ? `/${l}/${cat}` : `/${l}`;
}

const langPaths: Record<string, string> = { en: '/', cs: '/cs', es: '/es', de: '/de', pt: '/pt' };

let currentPost: (typeof allPosts)[number] | undefined;

if (pageType === 'category') {
	const catSlug = categorySlug(category as string);
	langPaths.en = localePath('en', catSlug);
	for (const l of LOCALES) if (l !== 'en') langPaths[l] = localePath(l, catSlug);
} else if (pageType === 'post') {
	currentPost = allPosts.find(p => p.id === slug);
	if (currentPost) {
		langPaths.en = `/${currentPost.id.split('/').pop()}`;
		if (currentPost.data.translation_id) {
			const translations = await getCollection('blog', ({ data }) =>
				isPublished(data) && data.translation_id === currentPost!.data.translation_id);
			for (const l of LOCALES) {
				if (l === 'en') continue;
				const t = translations.find(e => e.data.locale === l);
				langPaths[l] = t ? `/${l}/${t.id.split('/').pop()}` : localePath(l);
			}
		}
	}
}

const langProps = { enPath: langPaths.en, csPath: langPaths.cs, esPath: langPaths.es, dePath: langPaths.de, ptPath: langPaths.pt };
const canonical = pageType === 'post' && currentPost?.data.canonical;
---

{pageType === 'post' && currentPost && (
	<BaseLayout title={currentPost.data.title} description={currentPost.data.description} locale="en" canonical={canonical} {...langProps}>
		<Breadcrumbs locale="en" category={categoryDisplay(currentPost.data.categories[0])} categorySlug={categorySlug(currentPost.data.categories[0])} title={currentPost.data.title} />
		<BlogPost post={currentPost} />
		<PrevNext posts={allPosts} current={currentPost} locale="en" />
	</BaseLayout>
)}

{pageType === 'category' && (
	<BaseLayout title={`Category: ${categoryDisplay(category as string)}`} description={`Posts about ${categoryDisplay(category as string)}`} locale="en" {...langProps}>
		<Breadcrumbs locale="en" category={categoryDisplay(category as string)} categorySlug={categorySlug(category as string)} />
		<h1>Category: {categoryDisplay(category as string)}</h1>
		<PostList posts={allPosts.filter(p => p.data.categories.includes(category as string))} />
	</BaseLayout>
)}
