---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PostList from '../../../components/PostList.astro';
import { getCollection } from 'astro:content';

const TAG_LABELS: Record<string, string> = {
	cs: 'Tag',
	es: 'Etiqueta',
	de: 'Tag',
	pt: 'Tag',
};

export async function getStaticPaths() {
	const locales = ['cs', 'es', 'de', 'pt'];
	const pages: { params: { locale: string; tag: string }; props: Record<string, unknown> }[] = [];

	for (const locale of locales) {
		const posts = await getCollection('blog', ({ data }) => data.locale === locale && !data.draft);
		const tags = new Set<string>();
		for (const post of posts) {
			for (const tag of post.data.tags ?? []) {
				tags.add(tag);
			}
		}
		for (const tag of tags) {
			pages.push({ params: { locale, tag }, props: { locale, tag } });
		}
	}

	return pages;
}

const { locale, tag } = Astro.params as { locale: string; tag: string };

const posts = await getCollection('blog', ({ data }) => data.locale === locale && !data.draft && (data.tags ?? []).includes(tag));
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const langPaths: Record<string, string> = { en: `/tag/${tag}`, cs: '/cs', es: '/es', de: '/de', pt: '/pt' };

const checkLocales = ['cs', 'es', 'de', 'pt'];
for (const l of checkLocales) {
	const tposts = await getCollection('blog', ({ data }) => data.locale === l && !data.draft && (data.tags ?? []).includes(tag));
	if (tposts.length > 0) {
		langPaths[l] = `/${l}/tag/${tag}`;
	}
}

const langProps = { enPath: langPaths.en, csPath: langPaths.cs, esPath: langPaths.es, dePath: langPaths.de, ptPath: langPaths.pt };
const tagLabel = TAG_LABELS[locale] ?? 'Tag';
---

<BaseLayout title={`${tagLabel}: ${tag} — port.80.cz`} description={`Posts tagged with ${tag} in ${locale}`} locale={locale} {...langProps}>
	<Breadcrumbs locale={locale} tag={tag} />
	<h1>{tagLabel}: {tag}</h1>
	<PostList posts={posts} />
</BaseLayout>
