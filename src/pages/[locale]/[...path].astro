---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';

const LOCALES = ['en', 'cs', 'es', 'de', 'pt'] as const;

export async function getStaticPaths() {
	const ALL_CATEGORIES = ['AI', 'PostgreSQL'];
	const locales = ['cs', 'es', 'de', 'pt'];
	const allPages: { params: { locale: string; path?: string }; props: Record<string, unknown> }[] = [];

	for (const locale of locales) {
		const posts = await getCollection('blog', ({ data }) => data.locale === locale && !data.draft);

		for (const category of ALL_CATEGORIES) {
			allPages.push({ params: { locale, path: category }, props: { pageType: 'category', category, locale } });
		}

		for (const post of posts) {
			const slug = post.id.split('/').pop();
			allPages.push({ params: { locale, path: slug }, props: { pageType: 'post', slug: post.id, locale } });
		}
	}

	return allPages;
}

const { locale, path } = Astro.params as { locale: string; path?: string };
const { pageType, slug, category } = Astro.props as Record<string, unknown>;

const LABELS: Record<string, string> = { cs: 'Kategorie', es: 'Categoría', de: 'Kategorie', pt: 'Categoria' };

const allPosts = await getCollection('blog', ({ data }) => data.locale === locale && !data.draft);
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function localePath(l: string, cat?: string): string {
	if (l === 'en') return cat ? `/${cat}` : '/';
	return cat ? `/${l}/${cat}` : `/${l}`;
}

const langPaths: Record<string, string> = { en: '/', cs: '/cs', es: '/es', de: '/de', pt: '/pt' };
let currentPost: (typeof allPosts)[number] | undefined;

if (pageType === 'category') {
	for (const l of LOCALES) langPaths[l] = localePath(l, category as string);
} else if (pageType === 'post') {
	currentPost = allPosts.find(p => p.id === slug);
	if (currentPost) {
		langPaths[locale as string] = `/${locale}/${currentPost.id.split('/').pop()}`;
		if (currentPost.data.translation_id) {
			const translations = await getCollection('blog', ({ data }) =>
				data.translation_id === currentPost!.data.translation_id);
			for (const l of LOCALES) {
				if (l === locale) continue;
				const t = translations.find(e => e.data.locale === l);
				langPaths[l] = t ? (l === 'en' ? `/${t.id.split('/').pop()}` : `/${l}/${t.id.split('/').pop()}`) : localePath(l);
			}
		} else {
			for (const l of LOCALES) {
				if (l === locale) continue;
				langPaths[l] = localePath(l);
			}
		}
	}
}

const langProps = { enPath: langPaths.en, csPath: langPaths.cs, esPath: langPaths.es, dePath: langPaths.de, ptPath: langPaths.pt };
---

{pageType === 'post' && currentPost && (
	<BaseLayout title={currentPost.data.title} description={currentPost.data.description} locale={locale as string} {...langProps}>
		<BlogPost post={currentPost} />
	</BaseLayout>
)}

{pageType === 'category' && (
	<BaseLayout title={`Category: ${category}`} description={`Posts about ${category} in ${locale}`} locale={locale as string} {...langProps}>
		<h1>{LABELS[locale as string] ?? 'Category'}: {category as string}</h1>
		<ul>
			{allPosts.filter(p => p.data.categories.includes(category as string)).map(p => (
				<li>
					<a href={`/${locale}/${p.id.split('/').pop()}`}>{p.data.title}</a>
					<small> &mdash; {p.data.date.toLocaleDateString(locale as string, { year: 'numeric', month: 'short', day: 'numeric' })}</small>
					<p>{p.data.description}</p>
				</li>
			))}
		</ul>
	</BaseLayout>
)}
